# ── Required ──────────────────────────────────────────────────────────────────
DEVIN_API_TOKEN=apk_user_your_token_here
NEXT_PUBLIC_DEVIN_USER_EMAIL=you@company.com
NEXT_PUBLIC_DEVIN_USER_NAME=Your Name
NEXT_PUBLIC_DEVIN_ENTERPRISE_URL=https://your-org.devinenterprise.com

# ── Optional: Knowledge tab ───────────────────────────────────────────────────
# Set to true to enable the Knowledge tab (uses Devin knowledge API)
# KNOWLEDGE_ENABLED=true

# ── Optional: Orchestrator (Claude) ──────────────────────────────────────────
# Enables the Orchestrator tab and Claude session creation
# ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Vault (Postgres session history) ───────────────────────────────
# DATABASE_URL=postgresql://mission_control:localdev123@localhost:5432/mission_control
# POSTGRES_ENABLED=false
# POSTGRES_READ_ENABLED=false

# ── Optional: GitHub PR enrichment ───────────────────────────────────────────
# Enriches sessions with PR merge status
# GITHUB_TOKEN=gho_your_token_here

# ── Optional: Pattern-memory proxy ───────────────────────────────────────────
# Routes Devin API calls through a local pattern-memory proxy
# DEVIN_API_BASE=http://localhost:8080/v1
# PATTERN_MEMORY_PROXY_ENABLED=true

# ── Optional: Cron / local tooling ───────────────────────────────────────────
# CRON_SECRET=your-secret-key-here
# REPO_BASE_PATH=~/Desktop
# TERMINAL_APP=Ghostty
