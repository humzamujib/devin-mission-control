# ── Required ──────────────────────────────────────────────────────────────────
DEVIN_API_TOKEN=apk_user_your_token_here

# ── Recommended ───────────────────────────────────────────────────────────────
# Without email: all sessions in your org are shown (no user filtering)
NEXT_PUBLIC_DEVIN_USER_EMAIL=you@company.com
NEXT_PUBLIC_DEVIN_ENTERPRISE_URL=https://your-org.devinenterprise.com
# Only needed if Knowledge tab is enabled
NEXT_PUBLIC_DEVIN_USER_NAME=Your Name

# ── Optional: PR status enrichment ───────────────────────────────────────────
# Enables PR status on session cards. Sessions still load without this.
GITHUB_TOKEN=gho_your_token_here

# ── Optional: Claude orchestrator + child sessions ────────────────────────────
# Or just have Claude CLI installed and authenticated — no key needed
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Linear tickets ─────────────────────────────────────────────────
LINEAR_VAULT_REPO=owner/repo
LINEAR_SYNC_PLAYBOOK_ID=playbook-your_playbook_id

# ── Optional: Vault (patterns, changelogs, session records) ──────────────────
DATABASE_URL=postgresql://mission_control:localdev123@localhost:5432/mission_control
POSTGRES_ENABLED=false
POSTGRES_READ_ENABLED=false

# ── Optional: Show hidden tabs ───────────────────────────────────────────────
KNOWLEDGE_ENABLED=false

# ── Optional: misc ────────────────────────────────────────────────────────────
REPO_BASE_PATH=~/Desktop
TERMINAL_APP=Ghostty
# Secures the cron endpoint for external cron services
CRON_SECRET=your-secret-key-here
